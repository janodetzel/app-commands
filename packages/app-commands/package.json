{
	"name": "@janodetzel/app-commands",
	"version": "0.5.1",
	"description": "Run typed commands against a running app from a CLI, an MCP server, or the Metro dev tools, and keep the app's features reachable with lint and dependency-cruiser rules. Knows no UI framework.",
	"author": "Jano Detzel <jano@janodetzel.com>",
	"homepage": "https://github.com/janodetzel/app-commands#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/janodetzel/app-commands.git",
		"directory": "packages/app-commands"
	},
	"bugs": {
		"url": "https://github.com/janodetzel/app-commands/issues"
	},
	"publishConfig": {
		"registry": "https://registry.npmjs.org",
		"access": "public"
	},
	"main": "build/index.js",
	"types": "build/index.d.ts",
	"sideEffects": false,
	"scripts": {
		"build": "EXPO_NONINTERACTIVE=1 expo-module build && EXPO_NONINTERACTIVE=1 expo-module build cli && pnpm run build:mcp && pnpm run build:vite && pnpm run build:bin",
		"build:all": "expo-module prepare && pnpm run build:mcp && pnpm run build:vite && pnpm run build:bin && pnpm run web:export",
		"build:mcp": "tsc -p mcp/tsconfig.json",
		"build:vite": "tsc -p vite/tsconfig.json",
		"clean": "expo-module clean",
		"prepare": "expo-module prepare && pnpm run build:mcp && pnpm run build:vite",
		"prepublishOnly": "expo-module prepare && expo-module prepublishOnly && pnpm run build:mcp && pnpm run build:vite && pnpm run web:export",
		"web:dev": "cd webui && npx expo start -w",
		"web:export": "./scripts/build-webui.js",
		"typecheck": "tsc --noEmit",
		"build:bin": "chmod +x build/cli/index.js build/mcp/index.js"
	},
	"keywords": [
		"expo",
		"react-native",
		"expo-router",
		"ai-agents",
		"mcp",
		"model-context-protocol",
		"cli",
		"devtools",
		"commands",
		"testing",
		"zustand",
		"apollo"
	],
	"files": [
		"build",
		"dist",
		"eslint",
		"depcruise",
		"expo-module.config.json"
	],
	"license": "MIT",
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.30.0",
		"ws": "^8.21.3"
	},
	"devDependencies": {
		"@apollo/client": "^4.3.0",
		"@react-navigation/native": "^7.3.18",
		"@tanstack/react-router": "^1.170.41",
		"@types/react": "~19.2.2",
		"@types/ws": "^8.18.1",
		"expo": "~57.0.22",
		"expo-module-scripts": "^4.1.7",
		"expo-router": "~57.0.24",
		"graphql": "^17.0.2",
		"react": "19.2.3",
		"react-native": "0.86.3",
		"tinybase": "^6.4.2",
		"typescript": "~5.9.3",
		"vite": "^8.3.2",
		"zod": "^4.6.2",
		"zustand": "^5.0.15"
	},
	"peerDependencies": {
		"expo": ">=53.0.0",
		"@tanstack/react-router": ">=1.170.0",
		"react": "*",
		"tinybase": ">=6.0.0",
		"vite": ">=5.4.0",
		"zod": "^4.2.0"
	},
	"exports": {
		".": {
			"types": "./build/index.d.ts",
			"default": "./build/index.js"
		},
		"./expo": {
			"types": "./build/expo/index.d.ts",
			"default": "./build/expo/index.js"
		},
		"./web": {
			"types": "./build/web/index.d.ts",
			"default": "./build/web/index.js"
		},
		"./vite": {
			"types": "./build/vite/index.d.ts",
			"default": "./build/vite/index.js"
		},
		"./protocol": {
			"types": "./build/core/protocol.d.ts",
			"default": "./build/core/protocol.js"
		},
		"./conformance": {
			"types": "./build/conformance.d.ts",
			"default": "./build/conformance.js"
		},
		"./adapters/apollo": {
			"types": "./build/adapters/apollo.d.ts",
			"default": "./build/adapters/apollo.js"
		},
		"./adapters/expo-router": {
			"types": "./build/adapters/expo-router.d.ts",
			"default": "./build/adapters/expo-router.js"
		},
		"./adapters/key-value": {
			"types": "./build/adapters/key-value.d.ts",
			"default": "./build/adapters/key-value.js"
		},
		"./adapters/react-navigation": {
			"types": "./build/adapters/react-navigation.d.ts",
			"default": "./build/adapters/react-navigation.js"
		},
		"./adapters/tanstack-router": {
			"types": "./build/adapters/tanstack-router.d.ts",
			"default": "./build/adapters/tanstack-router.js"
		},
		"./adapters/tinybase": {
			"types": "./build/adapters/tinybase.d.ts",
			"default": "./build/adapters/tinybase.js"
		},
		"./adapters/zustand": {
			"types": "./build/adapters/zustand.d.ts",
			"default": "./build/adapters/zustand.js"
		},
		"./eslint": {
			"types": "./eslint/index.d.mts",
			"default": "./eslint/index.mjs"
		},
		"./depcruise": {
			"default": "./depcruise/index.cjs"
		},
		"./package.json": "./package.json"
	},
	"peerDependenciesMeta": {
		"@apollo/client": {
			"optional": true
		},
		"@react-navigation/native": {
			"optional": true
		},
		"@tanstack/react-router": {
			"optional": true
		},
		"expo": {
			"optional": true
		},
		"tinybase": {
			"optional": true
		},
		"vite": {
			"optional": true
		},
		"zustand": {
			"optional": true
		},
		"zod": {
			"optional": true
		}
	},
	"bin": {
		"app-commands": "build/cli/index.js",
		"app-commands-mcp": "build/mcp/index.js"
	}
}
